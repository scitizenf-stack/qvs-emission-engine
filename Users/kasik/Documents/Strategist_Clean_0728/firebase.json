{
  "hosting": {
    "public": "public", // Directory to serve static assets
    "ignore": [
      "firebase.json",       // Ignore the config file itself
      "**/.*",               // Ignore hidden files
      "**/node_modules/**"   // Ignore Node.js dependencies
    ]
  },
  "functions": {
    "source": "functions" // Location of Cloud Functions code
  },
  "firestore": {
    "rules": "firestore.rules" // Path to Firestore security rules
  }
}